            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.evervault.com/payments/network-tokens",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Create a Network Token for a given card.\n"
        },
        {
