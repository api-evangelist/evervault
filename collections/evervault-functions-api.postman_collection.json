  "item": [
    {
      "id": "2aef201b-4891-4190-b79b-ee40fe76e17e",
      "name": "Functions",
      "description": {
        "content": "Evervault [Functions](/functions) are secure serverless functions which allow you to process data encrypted by Evervault products. When you pass encrypted data to a Function, it is automatically decrypted. You can then process this data by running custom logic written in Node.js or Python as you usually would, but without ever handling it in plaintext on your infrastructure.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2dad3f2a-3d81-4057-bf9b-7be988666037",
          "name": "Run a Function",
          "request": {
            "name": "Run a Function",
            "description": {
              "content": "The Function run endpoint lets you invoke an [Evervault Function](/primitives/functions). The body of the request should contain a payload, the value of which will be decrypted and passed as an argument to the Function.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "functions",
                ":function_name",
                "runs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "function_name",
                  "description": "(Required) The name of the Function to be executed."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payload\": \"<object>\",\n  \"async\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
