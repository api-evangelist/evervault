{
  "opencollection": "1.0.0",
  "info": {
    "name": "Evervault Client Tokens API",
    "version": "0.0.1"
  },
  "items": [
    {
      "info": {
        "name": "Client Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a Client Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.evervault.com/client-side-tokens",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Client-Side Tokens are restricted to specific payloads. By default, a Client-Side Token will expire after 5 minutes. The maximum expiration time of a token is 10 minutes. When using the REST API, the expiry field must be in epoch milliseconds.\n"
        }
      ]
    }
  ],
  "bundled": true
}