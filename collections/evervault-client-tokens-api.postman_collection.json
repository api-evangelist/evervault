  "item": [
    {
      "id": "02ec8340-197c-4065-928f-de9ff7803d41",
      "name": "Client Tokens",
      "description": {
        "content": "Client-Side Tokens are short-lived tokens that can be used to perform actions from your frontend applications.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "125a7b2a-645c-47b6-a0fd-4585e9711fe0",
          "name": "Create a Client Token",
          "request": {
            "name": "Create a Client Token",
            "description": {
              "content": "Client-Side Tokens are restricted to specific payloads. By default, a Client-Side Token will expire after 5 minutes. The maximum expiration time of a token is 10 minutes. When using the REST API, the expiry field must be in epoch milliseconds.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "client-side-tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"<string>\",\n  \"payload\": \"<object>\",\n  \"expiry\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "dbe79ecc-91ca-4cb6-a379-83266d4c0abe",
