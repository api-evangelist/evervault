    {
      "id": "ba547cef-57ee-43c5-a92b-8b3c00554e92",
      "name": "Relays",
      "description": {
        "content": "Relay is a network proxy that can be configured to encrypt or decrypt sensitive data as it passes between a client and a destination server. Relay can be used with your own API or with third-party APIs. It is designed to be easy to use and requires minimal changes to your existing code.\n",
        "type": "text/plain"
      },
